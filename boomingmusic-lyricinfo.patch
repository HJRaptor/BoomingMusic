+    /**
+     * Resolves synced lyrics for the current item and stores them as MediaMetadata
+     * extras under [LYRIC_INFO_KEY], so ColorOS can show them on the lock screen.
+     * Does nothing if the current item already carries lyric info or was already tried.
+     */
+    private fun publishLyricInfo() {
+        val mediaItem = player.currentMediaItem ?: return
+        if (mediaItem.mediaMetadata.extras?.containsKey(LYRIC_INFO_KEY) == true) return
+        // Try once per track, so pausing/resuming never re-triggers a lyrics download.
+        if (mediaItem.mediaId == lyricInfoAttemptedId) return
+        lyricInfoAttemptedId = mediaItem.mediaId
+
+        lyricInfoJob?.cancel()
+        lyricInfoJob = serviceScope.launch(IO) {
+            val song = repository.songByMediaItem(mediaItem, ignoreBlacklist = true)
+            if (song == Song.emptySong) return@launch
+            val json = resolveSyncedLyrics(lyricsRepository, song)
+                ?.toLyricInfoJson(song, packageName)
+                ?: return@launch
+
+            withContext(Main) {
+                val current = player.currentMediaItem ?: return@withContext
+                // The track may have changed while the lyrics were loading.
+                if (current.mediaId != mediaItem.mediaId) return@withContext
+                val extras = current.mediaMetadata.extras?.let { Bundle(it) } ?: Bundle()
+                extras.putString(LYRIC_INFO_KEY, json)
+                player.replaceMediaItem(
+                    player.currentMediaItemIndex,
+                    current.buildUpon()
+                        .setMediaMetadata(current.mediaMetadata.buildUpon().setExtras(extras).build())
+                        .build()
+                )
+            }
+        }
+    }
+
+    /** Removes lyric info from every queue item except the current one, to keep the queue light. */
+    private fun clearStaleLyricInfo() {
+        val currentIndex = player.currentMediaItemIndex
+        for (i in 0 until player.mediaItemCount) {
+            if (i == currentIndex) continue
+            val item = player.getMediaItemAt(i)
+            val extras = item.mediaMetadata.extras ?: continue
+            if (!extras.containsKey(LYRIC_INFO_KEY)) continue
+            val cleaned = Bundle(extras).apply { remove(LYRIC_INFO_KEY) }
+            player.replaceMediaItem(
+                i,
+                item.buildUpon()
+                    .setMediaMetadata(item.mediaMetadata.buildUpon().setExtras(cleaned).build())
+                    .build()
+            )
+        }
+    }
+
