+/*
+ * Publishes timed lyrics in the "lyricInfo" MediaMetadata format that ColorOS/OPlus
+ * SystemUI reads for its native lock-screen / AOD lyric page.
+ */
+
+package com.mardous.booming.playback
+
+import com.mardous.booming.data.model.Song
+import com.mardous.booming.data.model.lyrics.LyricsSource
+import com.mardous.booming.data.model.lyrics.ParsedLyrics
+import com.mardous.booming.data.model.lyrics.SyncedLyrics
+import com.mardous.booming.data.repository.LyricsRepository
+import org.json.JSONObject
+import java.util.Locale
+
+/** Key under which the JSON payload is stored in the MediaMetadata extras. */
+const val LYRIC_INFO_KEY = "lyricInfo"
+
+/**
+ * Resolves synced lyrics for [song] using the same source order as the lyrics screen
+ * (file, embedded, downloaded). Returns null when there are no synced lyrics.
+ */
+suspend fun resolveSyncedLyrics(repository: LyricsRepository, song: Song): SyncedLyrics? {
+    for (source in listOf(LyricsSource.File, LyricsSource.Embedded, LyricsSource.Downloaded)) {
+        val raw = when (source) {
+            LyricsSource.File -> repository.fileLyrics(song)
+            LyricsSource.Embedded -> repository.embeddedLyrics(song)
+            LyricsSource.Downloaded -> repository.storedLyrics(song, allowDownload = true)
+        } ?: continue
+        when (val parsed = repository.parseRawLyrics(song, raw)) {
+            is ParsedLyrics.Synced -> return parsed.lyrics
+            is ParsedLyrics.Instrumental -> return null
+            else -> Unit
+        }
+    }
+    return null
+}
+
+/** Builds the lyricInfo JSON string (line-timed LRC, plus translations when present). */
+fun SyncedLyrics.toLyricInfoJson(song: Song, packageName: String): String? {
+    if (!hasContent) return null
+
+    val lrc = StringBuilder()
+    val translation = StringBuilder()
+    for (line in lines) {
+        val stamp = lrcTimestamp(line.start)
+        lrc.append(stamp).append(line.content.content.singleLine()).append('\n')
+        val translated = line.translation
+        if (translated != null && !translated.isEmpty) {
+            translation.append(stamp).append(translated.content.singleLine()).append('\n')
+        }
+    }
+
+    val json = JSONObject()
+        .put("songName", song.title)
+        .put("artist", song.artistName)
+        .put("songId", song.id.toString())
+        .put("lyricType", 0)
+        .put("lyric", lrc.toString())
+        .put("noLyric", false)
+        .put("provider", packageName)
+        .put("source", "$packageName-lyrics")
+        .put(
+            "trackKey",
+            "${song.id}|${song.title.lowercase()}|${song.artistName.lowercase()}|${song.duration / 1000}"
+        )
+        .put("sessionGeneration", 1)
+    if (translation.isNotEmpty()) {
+        json.put("translationLyric", translation.toString())
+    }
+    return json.toString()
+}
+
+private fun lrcTimestamp(ms: Long): String {
+    val minutes = ms / 60_000
+    val seconds = (ms / 1000) % 60
+    val millis = ms % 1000
+    return String.format(Locale.US, "[%02d:%02d.%03d]", minutes, seconds, millis)
+}
+
+private fun String.singleLine() = replace('\r', ' ').replace('\n', ' ')
